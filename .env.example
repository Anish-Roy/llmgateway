# Copy to .env and fill in. Never commit .env.

APP_ENV=dev
LOG_LEVEL=INFO

# Matches docker-compose.yml (host port 5433).
DATABASE_URL=postgresql://gateway:gateway@localhost:5433/gateway

# Provider keys (free tiers are enough).
GROQ_API_KEY=
GEMINI_API_KEY=

# Per provider call, and for the whole request including retries and fallbacks.
REQUEST_TIMEOUT_S=30
REQUEST_DEADLINE_S=45

# How long an API key lookup is cached: also how long a revoked key keeps working.
KEY_CACHE_TTL_S=30

# Tokens reserved against a key's TPM for a request without max_tokens, until real usage is known.
RATE_LIMIT_DEFAULT_COMPLETION_TOKENS=1024

# Model aliases and providers. Defaults to config/models.yaml.
# MODELS_FILE=config/models.yaml
