# Copy to .env and fill in. Never commit .env.

APP_ENV=dev
LOG_LEVEL=INFO

# Matches docker-compose.yml (host port 5433).
DATABASE_URL=postgresql://gateway:gateway@localhost:5433/gateway

# Provider keys (free tiers are enough).
GROQ_API_KEY=
GEMINI_API_KEY=

REQUEST_TIMEOUT_S=30

# groq | mock. "mock" returns canned replies and needs no keys.
PROVIDER=groq
MOCK_LATENCY_S=0
MOCK_FAILURE_RATE=0
