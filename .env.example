# Copy to .env and fill in. Never commit .env.

APP_ENV=dev
LOG_LEVEL=INFO

# Matches docker-compose.yml (host port 5433).
DATABASE_URL=postgresql://gateway:gateway@localhost:5433/gateway

# Provider keys (free tiers are enough).
GROQ_API_KEY=
GEMINI_API_KEY=

# Per provider call, and for the whole request including retries and fallbacks.
REQUEST_TIMEOUT_S=30
REQUEST_DEADLINE_S=45

# How long an API key lookup is cached: also how long a revoked key keeps working.
KEY_CACHE_TTL_S=30

# Tokens reserved against a key's TPM for a request without max_tokens, until real usage is known.
RATE_LIMIT_DEFAULT_COMPLETION_TOKENS=1024

# The exact-match cache answers requests with temperature set and at most this.
CACHE_MAX_TEMPERATURE=0.2
# How long a cached answer is served, in seconds (24 h).
CACHE_TTL_S=86400

# The semantic cache (opt-in per request with `x-gateway-cache: semantic`). Off, the embedding
# model is never loaded: startup is ~11 s faster and the process ~430 MB smaller.
SEMANTIC_CACHE_ENABLED=true
# MiniLM cosine similarity a stored question needs. At 0.95 the query log measured a 7.1% hit
# rate with 4 of 27 hits wrong (docs/decisions.md). Lower serves more, and more wrongly.
SEMANTIC_CACHE_THRESHOLD=0.95

# Model aliases and providers. Defaults to config/models.yaml.
# MODELS_FILE=config/models.yaml
